# --- Database (PostgreSQL) ---
# Pooled connection used by the app at runtime
DATABASE_URL="postgresql://user:password@host:6543/dbname?pgbouncer=true"
# Direct connection used by Prisma Migrate
DIRECT_URL="postgresql://user:password@host:5432/dbname"

# --- App ---
# Public base URL (falls back to the incoming request host)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Auth ---
# "dev" = local demo user, no identity provider (rejected in production).
# "kinde" = real sign-up/sign-in using the Kinde values below.
# When unset, defaults to "kinde" if Kinde is fully configured, otherwise "dev".
AUTH_PROVIDER="dev"

# --- Kinde (required when AUTH_PROVIDER=kinde) ---
KINDE_CLIENT_ID=""
KINDE_CLIENT_SECRET=""
KINDE_ISSUER_URL="https://your-app.kinde.com"
KINDE_SITE_URL="http://localhost:3000"
KINDE_POST_LOGIN_REDIRECT_URL="http://localhost:3000/dashboard"
KINDE_POST_LOGOUT_REDIRECT_URL="http://localhost:3000"

# --- Billing ---
# "mock" lets you explore Pro without Stripe. Use "stripe" in production.
# When unset, the provider is inferred from STRIPE_SECRET_KEY.
BILLING_PROVIDER="mock"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID=""

# --- AI (optional) ---
# "auto" uses AI_API_KEY when present, otherwise the offline heuristic provider
# (no key required, deterministic, good enough for summaries and tags).
# Any OpenAI-compatible endpoint works: OpenAI, Groq, OpenRouter, Ollama, etc.
AI_PROVIDER="auto"
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
# External AI calls per user per day. The heuristic provider is free and unlimited.
AI_DAILY_LIMIT="50"
