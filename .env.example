# --- Database (PostgreSQL) ---
# Pooled connection used by the app at runtime
DATABASE_URL="postgresql://user:password@host:6543/dbname?pgbouncer=true"
# Direct connection used by Prisma Migrate
DIRECT_URL="postgresql://user:password@host:5432/dbname"

# --- App ---
# Public base URL (falls back to the incoming request host)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Kinde (required to sign in) ---
KINDE_CLIENT_ID=""
KINDE_CLIENT_SECRET=""
KINDE_ISSUER_URL="https://your-app.kinde.com"
KINDE_SITE_URL="http://localhost:3000"
KINDE_POST_LOGIN_REDIRECT_URL="http://localhost:3000/dashboard"
KINDE_POST_LOGOUT_REDIRECT_URL="http://localhost:3000"

# --- Billing ---
# "mock" lets you explore Pro without Stripe. Use "stripe" in production.
# When unset, the provider is inferred from STRIPE_SECRET_KEY.
BILLING_PROVIDER="mock"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID=""
