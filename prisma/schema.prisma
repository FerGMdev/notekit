// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String        @id
  name             String?
  email            String?       @unique
  stripeCustomerId String?       @unique
  colorScheme      String?       @default("theme-rose")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  Subscription     Subscription?
  Notes            Note[]
  Collections      Collection[]
  AiUsage          AiUsage[]
}

/// A collection is a lightweight folder for notes and snippets. It is not a
/// permission boundary: every row still filters by `userId`.
model Collection {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  User   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  Notes  Note[]

  @@unique([userId, name])
  @@index([userId, updatedAt(sort: Desc)])
}

/// Notes and snippets share one entity on purpose: tabs, search, favourites,
/// trash, sharing, export and AI all work for both without a second pipeline.
enum NoteKind {
  NOTE
  SNIPPET
}

model Subscription {
  stripeSubscriptionId String   @id
  interval             String
  status               String
  planId               String
  currentPeriodEnd     Int
  currentPeriodStart   Int
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId               String   @unique
}

model Note {
  id          String    @id @default(uuid())
  title       String
  description String
  kind        NoteKind  @default(NOTE)
  // Set for snippets only: drives the language filter and the badge.
  language    String?
  tags        String[]  @default([])
  isFavorite  Boolean   @default(false)
  deletedAt   DateTime?
  // AI output is cached on the note: regenerate explicitly, not on every view.
  summary          String?
  summaryUpdatedAt DateTime?
  // Null while private; a random, unguessable token while shared.
  shareId     String?   @unique
  sharedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  User   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  Collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  collectionId String?

  @@index([userId, updatedAt(sort: Desc)])
  @@index([userId, deletedAt, updatedAt(sort: Desc)])
  @@index([userId, isFavorite])
  @@index([userId, kind, updatedAt(sort: Desc)])
  @@index([userId, language])
  @@index([userId, collectionId])
}

/// Per-user, per-day counter so AI cost cannot run away. Only external
/// providers consume quota; the built-in heuristic is free.
model AiUsage {
  id     String   @id @default(uuid())
  userId String
  day    DateTime @db.Date
  count  Int      @default(0)

  User User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
}
